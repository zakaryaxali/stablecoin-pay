# Database connection (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stablecoin_pay

# Solana RPC URL (mainnet-beta, devnet, or custom)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# USDC mint address (mainnet)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Server port
PORT=3000

# HELIUS API KEY (SOLANA RPC)
HELIUS_API_KEY=

# ----------------------------------------------------------------------------
# Autonomous payment agent (cargo run --bin agent)
# ----------------------------------------------------------------------------
# The agent custodies a key and signs autonomously. Run it against DEVNET:
# set SOLANA_RPC_URL above to a devnet endpoint and USDC_MINT to the devnet mint
# (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU). The agent refuses non-devnet
# RPCs unless AGENT_ALLOW_MAINNET=true.

# Anthropic API key for the in-loop Claude settlement decision
ANTHROPIC_API_KEY=
# Claude model for settlement decisions
ANTHROPIC_MODEL=claude-sonnet-4-6

# Treasury secret key (base58) or path to a Solana CLI keypair file
AGENT_KEYPAIR=
# Faucet secret key (base58) or keypair file, used to simulate inbound payments
FAUCET_KEYPAIR=
# Treasury wallet address the agent watches for inbound USDC
TREASURY_ADDRESS=

# Policy guardrails (enforced in Rust after Claude decides)
MAX_PAYOUT_USDC=100
DAILY_LIMIT_USDC=1000

# Seconds between agent loop iterations
AGENT_LOOP_INTERVAL_SECS=30
# Allow the agent to run against a non-devnet RPC (default false)
AGENT_ALLOW_MAINNET=false

